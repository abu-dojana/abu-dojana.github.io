---
import { itemUrl } from '../lib/content';
import type { SectionItem } from '../lib/types';

interface Props {
  item: SectionItem;
}

const { item } = Astro.props;
const href = itemUrl(item);
const statusLabels: Record<string, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  completed: 'Completed',
  archived: 'Archived',
};
const chips = item.tech.length > 0 ? item.tech : item.tags;
---
<article class="project-card">
  {item.cover && (
    <a class="project-card__media" href={href} tabindex="-1" aria-hidden="true">
      <img src={item.cover} alt={item.coverAlt} loading="lazy" width="1200" height="750" />
      {item.images.length > 1 && (
        <span class="project-card__photos">{item.images.length} photos</span>
      )}
    </a>
  )}
  <div class="project-card__body">
    <div class="project-card__meta">
      {item.dateLabel && <span>{item.dateLabel}</span>}
      {item.status && statusLabels[item.status] && (
        <span class="project-card__status">{statusLabels[item.status]}</span>
      )}
    </div>
    <h3>
      <a href={href}>
        <span>{item.title}</span>
        <span class="project-card__arrow" aria-hidden="true">→</span>
      </a>
    </h3>
    {item.summary && <p class="project-card__summary">{item.summary}</p>}
    {chips.length > 0 && (
      <div class="project-card__chips">
        {chips.slice(0, 6).map(chip => <span class="pill">{chip}</span>)}
      </div>
    )}
    <div class="project-card__actions">
      <a class="project-card__details" href={href}>View details →</a>
      <div class="project-card__ext">
        {item.liveUrl && (
          <a href={item.liveUrl} target="_blank" rel="noopener noreferrer">Live ↗</a>
        )}
        {item.repoUrl && (
          <a href={item.repoUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
  }
  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s;
  }
  .project-card:hover .project-card__media img {
    transform: scale(1.02);
  }
  .project-card__photos {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--surface);
    color: var(--ink);
    font: 10px/1.3 var(--mono);
  }
  .project-card__body {
    padding: 1.35rem 1.45rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font: 10px var(--mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .project-card__status {
    color: var(--accent);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 6px;
    background: var(--accent-soft);
  }
  h3 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.025em;
    margin: 0 0 10px;
  }
  h3 a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .project-card__arrow {
    font: 1rem var(--sans);
    color: var(--accent);
    padding-top: 3px;
    flex: none;
  }
  .project-card__summary {
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.65;
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .project-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    font-weight: 600;
  }
  .project-card__details {
    color: var(--accent);
  }
  .project-card__ext {
    display: flex;
    gap: 12px;
    color: var(--muted);
    font-weight: 500;
  }
  .project-card__ext a:hover {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media img {
      transition: none;
    }
    .project-card:hover,
    .project-card:hover .project-card__media img {
      transform: none;
    }
  }
</style>
