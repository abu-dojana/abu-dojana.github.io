---
import '../styles/themes.css';
---
<div class="theme-switch" role="group" aria-label="Color theme" data-theme-picker>
  <button type="button" class="theme-option" data-theme-option="system" aria-pressed="true" title="Follow system theme">
    <svg aria-hidden="true" viewBox="0 0 20 20"><rect x="2" y="3" width="16" height="11" rx="1.5"/><path d="M7 17h6M10 14v3"/></svg>
    <span>System</span>
  </button>
  <button type="button" class="theme-option" data-theme-option="light-paper" aria-pressed="false" title="Light theme (Paper)">
    <svg aria-hidden="true" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.4"/><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"/></svg>
    <span>Light</span>
  </button>
  <button type="button" class="theme-option" data-theme-option="dark-charcoal" aria-pressed="false" title="Dark theme (Charcoal)">
    <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M16.9 12.8A7.5 7.5 0 0 1 7.2 3.1a7.5 7.5 0 1 0 9.7 9.7Z"/></svg>
    <span>Dark</span>
  </button>
</div>
