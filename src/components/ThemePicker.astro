---
import { themes } from '../lib/themes';
import '../styles/themes.css';

const groups = [
  { mode: 'light', label: 'Light themes' },
  { mode: 'dark', label: 'Dark themes' },
] as const;
---
<details class="theme-menu" data-theme-picker data-theme-mode="system">
  <summary class="theme-toggle" aria-label="Choose color theme">
    <span class="theme-toggle-icon" aria-hidden="true">
      <svg data-theme-icon="system" viewBox="0 0 20 20"><rect x="2" y="3" width="16" height="11" rx="1.5"/><path d="M7 17h6M10 14v3"/></svg>
      <svg data-theme-icon="light" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.4"/><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"/></svg>
      <svg data-theme-icon="dark" viewBox="0 0 20 20"><path d="M16.9 12.8A7.5 7.5 0 0 1 7.2 3.1a7.5 7.5 0 1 0 9.7 9.7Z"/></svg>
    </span>
    <span class="theme-toggle-name" data-theme-name>System</span>
    <svg class="theme-toggle-chevron" aria-hidden="true" viewBox="0 0 12 12"><path d="m2 4 4 4 4-4"/></svg>
  </summary>
  <div class="theme-panel">
    <div class="theme-panel-heading"><h2>Color theme</h2><button class="theme-close" type="button" aria-label="Close theme picker" data-theme-close><span aria-hidden="true">×</span></button></div>
    <p class="theme-panel-note">Choose a palette for this browser.</p>
    <fieldset class="theme-system-options" data-theme-options disabled>
      <legend class="sr-only">Automatic theme</legend>
      <label class="theme-choice theme-system-choice">
        <input type="radio" name="color-theme" value="system" aria-label="System" data-theme-option checked />
        <span class="theme-system-copy"><strong>System</strong><small>Follow your device’s light or dark mode</small></span>
      </label>
    </fieldset>
    {groups.map(group => <fieldset class="theme-group" data-theme-options disabled>
      <legend>{group.label}</legend>
      <div class="theme-grid">{themes.filter(theme => theme.mode === group.mode).map(theme => <label class="theme-choice">
        <input type="radio" name="color-theme" value={theme.id} data-theme-option />
        <span class="theme-swatches" aria-hidden="true" style={`--swatch-bg:${theme.colors.bg};--swatch-surface:${theme.colors.surface};--swatch-accent:${theme.colors.accent}`}><i></i><i></i><i></i></span>
        <span class="theme-choice-name">{theme.name}</span>
      </label>)}</div>
    </fieldset>)}
    <noscript><p class="theme-panel-note theme-noscript">Your device’s theme is active. Enable JavaScript to choose another palette.</p></noscript>
  </div>
</details>
