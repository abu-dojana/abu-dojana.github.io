---
import type { CvModel } from '../lib/cv';

interface Props {
  model: CvModel;
  documentId?: string;
}

const { model, documentId = 'cv-document' } = Astro.props;
const { profile, sections } = model;
const hasContacts = Boolean(
  profile.email || profile.phone || profile.location || profile.links.length > 0,
);

const cleanUrl = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/i, '').replace(/\/+$/, '');
---

<article class="cv-document" id={documentId} aria-label="Curriculum Vitae">
  <header class="cv-document-header">
    <h1>{profile.name}</h1>
    {profile.headline && <p class="cv-headline">{profile.headline}</p>}
    {hasContacts && (
      <div class="cv-contact">
        {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
        {profile.phone && <span>{profile.phone}</span>}
        {profile.location && <span>{profile.location}</span>}
        {profile.links.map(link => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}: {cleanUrl(link.url)}
          </a>
        ))}
      </div>
    )}
  </header>

  {profile.summary && (
    <section class="cv-section">
      <h2>Summary</h2>
      <p class="cv-summary">{profile.summary}</p>
    </section>
  )}

  {sections.map(section => (
    <section class="cv-section">
      <h2>{section.title}</h2>
      <div class="cv-section-entries">
        {section.entries.map(entry => (
          <article class="cv-entry">
            <div class="cv-entry-heading">
              <h3>{entry.title}</h3>
              {entry.date && <span class="cv-entry-date">{entry.date}</span>}
            </div>
            {(entry.subtitle || entry.location) && (
              <p class="cv-entry-subtitle">
                {[entry.subtitle, entry.location].filter(Boolean).join(' · ')}
              </p>
            )}
            {entry.summary && <p class="cv-entry-summary">{entry.summary}</p>}
            {entry.bullets.length > 0 && (
              <ul>
                {entry.bullets.map(bullet => <li>{bullet}</li>)}
              </ul>
            )}
            {entry.tech.length > 0 && (
              <p class="cv-entry-tech">
                <strong>Technologies:</strong> {entry.tech.join(', ')}
              </p>
            )}
            {entry.links.length > 0 && (
              <p class="cv-entry-links">
                {entry.links.map(link => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}: {cleanUrl(link.url)}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  {profile.skillGroups.length > 0 && (
    <section class="cv-section">
      <h2>Skills</h2>
      <div class="cv-skills-list">
        {profile.skillGroups.map(group => (
          <p class="cv-skill-row">
            <strong>{group.category}:</strong> {group.items.join(', ')}
          </p>
        ))}
      </div>
    </section>
  )}
</article>
