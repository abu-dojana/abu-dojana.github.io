---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvDocument from '../../components/CvDocument.astro';
import { getSite } from '../../lib/content';
import { createCvModel } from '../../lib/cv';
import '../../styles/cv.css';

const site = getSite();
const model = createCvModel(site);
---

<BaseLayout
  title="CV"
  description="Curriculum Vitae compiled from portfolio projects, experience, education, and skills."
  active="cv"
>
  <section class="cv-page">
    <div class="cv-page-intro cv-app-only">
      <p class="cv-eyebrow">Curriculum Vitae</p>
      <h1>{model.profile.name || 'Curriculum Vitae'}</h1>
      <p>A clean, ATS-friendly CV compiled directly from portfolio entries.</p>
    </div>

    {model.ready ? (
      <>
        <div class="cv-toolbar cv-app-only">
          <button class="cv-button cv-button-primary" type="button" data-cv-print>
            Print / Save as PDF <span aria-hidden="true">↗</span>
          </button>
          <p>Choose “Save as PDF” in your browser’s print dialog (A4, headers and footers off).</p>
        </div>
        <CvDocument model={model} />
      </>
    ) : (
      <div class="cv-setup cv-app-only">
        <h2>CV not populated yet.</h2>
        <p>
          Add your name in Profile &amp; website settings and publish at least one experience,
          project, education, or skill group entry to generate your CV.
        </p>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  function initializeCvPrint() {
    document.querySelectorAll<HTMLButtonElement>('[data-cv-print]').forEach(button => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.addEventListener('click', () => window.print());
    });
  }
  initializeCvPrint();
  document.addEventListener('astro:page-load', initializeCvPrint);
</script>
