---
import { getSite, sectionUrl } from '../../lib/content';

export function getStaticPaths() {
  const site = getSite();
  const paths = site.sections
    .filter(section => section.published)
    .map(section => ({
      params: { slug: section.slug },
      props: { destination: sectionUrl(section) },
    }));
  return paths;
}

const { destination } = Astro.props as { destination: string };
return Astro.redirect(destination, 301);
---
