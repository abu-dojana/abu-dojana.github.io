---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getSite, formatDate } from '../../lib/content';
import type { Entry, Page, SiteContent } from '../../lib/types';
export function getStaticPaths() {
  const site = getSite();
  return site.pages.filter(page => page.published).map(page => ({ params: { slug: page.slug }, props: { page, site } }));
}
const { page, site } = Astro.props as { page: Page; site: SiteContent };
const items = page.items.filter(item => item.published);
const progressLabels = { planned: 'Planned', 'in-progress': 'In progress', completed: 'Completed', '': '' };
const dateLabel = (item: Entry) => item.date ? `${formatDate(item.date)}${item.endDate ? ` — ${formatDate(item.endDate)}` : ''}` : item.endDate ? `Until ${formatDate(item.endDate)}` : '';
---
<BaseLayout title={page.title} description={page.summary} active={page.id}>
  <article class="container standalone-page">
    <a class="breadcrumb" href="/pages/">← All pages</a>
    <header class="standalone-heading"><p class="eyebrow">A page of its own</p><h1>{page.title}<span>.</span></h1>{page.summary && <p class="standalone-summary muted">{page.summary}</p>}{page.example && <p class="sample-notice">Example page · Illustrative content, ready to make your own.</p>}</header>
    {page.html && <div class="standalone-intro"><div class="prose" set:html={page.html}></div></div>}

    {items.length > 0 && <section class:list={['page-items', `page-items--${page.layout}`]} aria-label={`${page.navigationLabel || page.title} items`}>
      <div class="items-heading"><h2>On this page</h2><span>{items.length} {items.length === 1 ? 'item' : 'items'}</span></div>
      {page.layout === 'cards' && <div class="page-items-grid">{items.map(item => <EntryCard entry={item} pages={site.pages} />)}</div>}
      {(page.layout === 'list' || page.layout === 'timeline') && <ol role="list" class:list={['page-item-list', { 'page-item-timeline': page.layout === 'timeline' }]}>
        {items.map(item => {
          const date = dateLabel(item);
          const hasMetadata = Boolean(date || item.progress);
          const hasDetail = Boolean(item.body.trim() || item.cover || item.links.some(link => link.url.trim()));
          return <li class:list={{ 'item-without-meta': !hasMetadata }}>
            {hasMetadata && <div class="item-date"><span>{date || progressLabels[item.progress]}</span></div>}
            <div class="item-list-content"><div class="item-list-flags">{item.example && <span class="page-example-label">Example</span>}{date && item.progress && <span class="item-progress">{progressLabels[item.progress]}</span>}</div><h3>{hasDetail ? <a href={`/entries/${item.slug}/`}>{item.title}<span aria-hidden="true">↗</span></a> : item.title}</h3>{item.summary && <p>{item.summary}</p>}{item.details.length > 0 && <dl class="item-inline-details">{item.details.map(detail => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>}{hasDetail && <a class="item-read-link" href={`/entries/${item.slug}/`} aria-label={`Read more about ${item.title}`}>Read more <span aria-hidden="true">→</span></a>}</div>
          </li>;
        })}
      </ol>}
      {page.layout === 'article' && <div class="article-items">{items.map(item => <section class="article-item" id={`item-${item.id}`}>
        <div class="article-item-meta">{item.example && <span class="page-example-label">Example</span>}{dateLabel(item) && <span>{dateLabel(item)}</span>}{item.progress && <span>{progressLabels[item.progress]}</span>}</div>
        <h3><a href={`/entries/${item.slug}/`}>{item.title}<span aria-hidden="true">↗</span></a></h3>
        {item.summary && <p class="article-item-summary muted">{item.summary}</p>}
        {item.cover && <figure><img src={item.cover} alt={item.coverAlt || ''} loading="lazy" width="1200" height="800" /></figure>}
        {item.html && <div class="prose" set:html={item.html}></div>}
        {item.links.length > 0 && <div class="article-item-links">{item.links.map(link => <a href={link.url} rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
      </section>)}</div>}
    </section>}
    {!items.length && (page.layout !== 'article' || !page.html) && <div class="empty-state page-empty"><h2>More to come.</h2><p>New additions will appear on this page.</p></div>}
    <footer class="page-end"><a href="/pages/">Browse another page <span aria-hidden="true">→</span></a></footer>
  </article>
</BaseLayout>
<style>
  .standalone-page { padding-block: 2.5rem 4rem; }
  .standalone-heading { max-width: 850px; margin: 3rem 0 2.5rem; }
  .standalone-heading h1 { margin-block: 1rem; font-size: clamp(2.8rem, 6vw, 5.2rem); }
  .standalone-heading h1 span { color: var(--accent); }
  .standalone-summary { max-width: 58ch; font-size: 1.1rem; line-height: 1.8; }
  .sample-notice { display: inline-block; border: 1px dashed var(--line); padding: .5rem .75rem; color: var(--muted); font-size: .72rem; border-radius: 4px; }
  .standalone-intro { max-width: 800px; margin-bottom: 3rem; }
  .items-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 2rem; margin-bottom: 2rem; border-top: 1px solid var(--line); }
  .items-heading h2 { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .13em; color: var(--accent); margin: 0; }
  .items-heading > span { font-size: .72rem; color: var(--muted); }
  .page-items-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .page-item-list { padding: 0; margin: 0; list-style: none; }
  .page-item-list > li { display: grid; grid-template-columns: minmax(135px, .6fr) minmax(0, 2fr); gap: 2rem; padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--line); }
  .page-item-list > li.item-without-meta { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .item-date { color: var(--muted); font-size: .73rem; padding-top: .35rem; }
  .item-list-flags { display: flex; align-items: center; gap: .6rem; }
  .item-list-flags:empty { display: none; }
  .item-progress { color: var(--muted); font-size: .68rem; }
  .item-list-content h3, .article-item h3 { font-family: var(--serif); font-size: 1.75rem; font-weight: 400; margin: .4rem 0 .75rem; letter-spacing: -.025em; }
  .item-list-content h3 a, .article-item h3 a { display: flex; justify-content: space-between; gap: 1rem; }
  .item-list-content h3 a span, .article-item h3 a span { color: var(--accent); font: 1rem var(--sans); padding-top: .25rem; }
  .item-list-content > p { color: var(--muted); font-size: .91rem; max-width: 65ch; line-height: 1.8; }
  .item-read-link { display: inline-flex; gap: .7rem; color: var(--accent); font-size: .76rem; margin-top: .7rem; }
  .item-inline-details { display: flex; flex-wrap: wrap; gap: .7rem 1.5rem; margin: 1rem 0; font-size: .75rem; }
  .item-inline-details > div { display: flex; gap: .4rem; }
  .item-inline-details dt { color: var(--muted); }
  .item-inline-details dt::after { content: ':'; }
  .item-inline-details dd { margin: 0; }
  .page-item-timeline { padding-left: 1rem; }
  .page-item-timeline > li { border-left: 1px solid var(--line); border-bottom: 0; position: relative; padding-left: 1.9rem; padding-top: 0; padding-bottom: 3rem; }
  .page-item-timeline > li::before { content: ''; position: absolute; left: -.32rem; top: .45rem; width: .6rem; height: .6rem; border: 2px solid var(--bg); background: var(--accent); border-radius: 50%; }
  .page-item-timeline > li:last-child { padding-bottom: .5rem; }
  .article-items { max-width: 800px; }
  .article-item + .article-item { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 3rem; }
  .article-item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; color: var(--muted); font-size: .7rem; margin-bottom: .7rem; }
  .article-item-summary { line-height: 1.8; }
  .article-item figure { margin: 1.5rem 0; }
  .article-item img { border-radius: var(--radius); width: 100%; max-height: 400px; object-fit: cover; }
  .article-item-links { display: flex; flex-wrap: wrap; gap: .7rem 1.5rem; color: var(--accent); font-size: .8rem; margin-top: 1.5rem; }
  .page-empty { max-width: 800px; margin-top: 2rem; }
  .page-end { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; color: var(--accent); font-size: .8rem; }
  @media (max-width: 650px) { .standalone-heading { margin-top: 2rem; } .page-items-grid { grid-template-columns: 1fr; } .page-item-list > li { grid-template-columns: 1fr; gap: .7rem; } .item-date { padding-top: 0; } .page-item-timeline > li { padding-left: 1.25rem; } }
</style>
