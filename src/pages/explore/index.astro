---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getSite } from '../../lib/content';
const site = getSite();
const entries = site.entries.filter((entry) => entry.published).sort((a, b) => b.date.localeCompare(a.date));
const tags = [...new Set(entries.flatMap((entry) => entry.tags))].sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="Explore" description="Browse the notebook: experiences, ideas, things made, and anything in between." active="explore">
  <section class="container explore-page">
    <header class="explore-heading"><p class="eyebrow">Follow a little curiosity</p><h1 class="page-heading">The notebook<span>.</span></h1><p class="muted">Experiences, ideas, things made, and anything in between.<br />Pick a thread, or see where the pages take you.</p></header>
    <form class="explore-filters" id="explore-filters" role="search" hidden>
      <div class="search-field"><label for="entry-search">Search the notebook</label><div class="search-input"><span aria-hidden="true">⌕</span><input id="entry-search" name="q" type="search" placeholder="A topic, a thought, a word…" autocomplete="off" /></div></div>
      <div class="select-field"><label for="category-filter">Category</label><select id="category-filter" name="category"><option value="">All categories</option>{site.categories.map((category) => <option value={category.id} data-slug={category.slug}>{category.title}</option>)}</select></div>
      <div class="select-field"><label for="tag-filter">Tag</label><select id="tag-filter" name="tag"><option value="">All tags</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></div>
      <button type="reset" class="reset-filters">Clear filters</button>
    </form>
    <div class="results-heading"><p id="result-count" role="status" aria-live="polite">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p><span class="muted">A little of everything</span></div>
    <h2 class="sr-only">Published entries</h2>
    <div class="explore-grid" id="explore-results">{entries.map((entry) => <EntryCard entry={entry} categories={site.categories} searchable />)}</div>
    <div class="empty-state" id="no-results" hidden={entries.length > 0}><h2>No pages found.</h2><p>Try another word or clear the filters to explore everything.</p><button type="button" class="button secondary" id="clear-empty-filters" hidden>Clear filters</button></div>
    <noscript><p class="muted">All published entries are shown. Enable JavaScript to search and filter this list.</p></noscript>
  </section>
</BaseLayout>
<script>import '../../scripts/explore';</script>
<style>
  .explore-page { padding-block: 4rem 5rem; }
  .explore-heading { margin-bottom: 2.7rem; }
  .explore-heading h1 { margin-block: 1rem; padding: 0; max-width: none; }
  .explore-heading h1 span { color: var(--accent); }
  .explore-heading > p:last-child { max-width: 58ch; line-height: 1.8; font-size: .98rem; }
  .explore-filters { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 1rem; align-items: end; border-block: 1px solid var(--line); padding: 1.4rem 0; }
  .explore-filters[hidden] { display: none; }
  label { display: block; font-size: .65rem; font-weight: 650; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .5rem; color: var(--muted); }
  input, select { width: 100%; min-width: 0; border: 1px solid var(--line); border-radius: 5px; padding: .75rem .85rem; background: var(--surface); color: var(--ink); font: inherit; font-size: .85rem; min-height: 2.9rem; }
  .search-input { position: relative; }
  .search-input > span { position: absolute; left: .85rem; top: .48rem; color: var(--muted); font-size: 1.5rem; pointer-events: none; }
  .search-input input { padding-left: 2.5rem; }
  .reset-filters { min-height: 2.9rem; border: 0; background: transparent; color: var(--accent); text-decoration: underline; text-underline-offset: .25rem; font-size: .78rem; padding: .7rem .2rem; cursor: pointer; }
  .results-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.1rem 0; font-size: .7rem; }
  .results-heading p { margin: 0; }
  .results-heading > span { font-style: italic; }
  .explore-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  @media (max-width: 950px) { .explore-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .explore-filters { grid-template-columns: 2fr 1fr 1fr; } .reset-filters { grid-column: 1 / -1; justify-self: start; min-height: 1.5rem; padding-block: 0; } }
  @media (max-width: 600px) { .explore-page { padding-top: 2.5rem; } .explore-grid { grid-template-columns: 1fr; } .explore-filters { grid-template-columns: 1fr 1fr; } .search-field { grid-column: 1 / -1; } }
</style>
