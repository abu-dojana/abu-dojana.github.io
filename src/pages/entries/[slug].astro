---
import { getSite, itemUrl } from '../../lib/content';

export function getStaticPaths() {
  const site = getSite();
  const seen = new Set<string>();
  const paths: { params: { slug: string }; props: { destination: string } }[] = [];

  for (const item of site.allItems) {
    if (!item.published || seen.has(item.slug)) continue;
    seen.add(item.slug);
    paths.push({
      params: { slug: item.slug },
      props: { destination: itemUrl(item) },
    });
  }

  // Preserve the legacy SpaceTabs permalink from before the content refactor.
  const spacetabs = site.projects.find(project => project.published && project.slug === 'spacetabs');
  const legacySlug = 'item-50000000-0000-4000-8000-000000000002';
  if (spacetabs && !seen.has(legacySlug)) {
    paths.push({
      params: { slug: legacySlug },
      props: { destination: itemUrl(spacetabs) },
    });
  }

  return paths;
}

const { destination } = Astro.props as { destination: string };
return Astro.redirect(destination, 301);
---
