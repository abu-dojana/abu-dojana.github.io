---
import { getSite } from '../../lib/content';
export function getStaticPaths() {
  const site = getSite();
  return site.categories.map(category => {
    const page = site.pages.find(candidate => candidate.published && candidate.slug === category.slug);
    return { params: { slug: category.slug }, props: { destination: page ? `/pages/${page.slug}/` : '/pages/' } };
  });
}
const { destination } = Astro.props as { destination: string };
return Astro.redirect(destination, 301);
---
